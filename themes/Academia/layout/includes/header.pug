.header_wrap
    #blog_name
        a#site-name.blog_title(href=url_for('/')) #[=config.title]
    button.menus_icon
        .navicon
    ul.menus_items
        each value, label in theme.menu
            if !Array.isArray(value)
                li.menus_item
                    if label == 'Conjugation App'
                        a.site-page(
                            href=url_for(trim(value.split('||')[0]))
                            target="_blank"
                            rel="noopener noreferrer"
                        )=' ' + label
                    else
                        a.site-page(href=url_for(trim(value.split('||')[0])))=' ' + label
            else
                li.menus_item
                    a.site-page=' ' + trim(label.split('||')[0])
